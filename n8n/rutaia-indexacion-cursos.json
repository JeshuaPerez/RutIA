      {
        "id": "a3c0e0b0-0000-4000-8000-000000000011",
        "name": "Leer cursos",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.5,
        "position": [
          440,
          100
        ],
        "parameters": {
          "method": "GET",
          "url": "={{ $json.apiBaseUrl }}/admin/cursos",
          "options": {
            "response": {
              "response": {
                "fullResponse": true,
                "neverError": true
              }
            }
          }
        },
        "onError": "continueErrorOutput"
      },
      {
        "id": "a3c0e0b0-0000-4000-8000-000000000012",
        "name": "Validar cursos",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          660,
          100
        ],
        "parameters": {
          "jsCode": "// Valida la respuesta de GET {apiBaseUrl}/admin/cursos (E-07) antes de gastar cuota.\nconst resp = $input.first().json;\nif (resp.statusCode !== 200) {\n  throw new Error(`La API respondió HTTP ${resp.statusCode} en GET /admin/cursos`);\n}\nconst cursos = resp.body;\nif (!Array.isArray(cursos)) {\n  throw new Error('La API no devolvió un arreglo de cursos en GET /admin/cursos');\n}\nif (cursos.length < 20) {\n  throw new Error(`Se necesitan al menos 20 cursos y la API devolvió ${cursos.length}`);\n}\nconst ids = new Set();\nfor (const c of cursos) {\n  if (!Number.isInteger(c.id) || c.id < 1) {\n    throw new Error(`Curso con id inválido: ${JSON.stringify(c.id)}`);\n  }\n  if (ids.has(c.id)) {\n    throw new Error(`El curso id ${c.id} aparece dos veces`);\n  }\n  ids.add(c.id);\n  for (const campo of ['nombre', 'descripcion', 'categoria', 'nivel']) {\n    if (typeof c[campo] !== 'string' || !c[campo].trim()) {\n      throw new Error(`El curso id ${c.id} no tiene ${campo}`);\n    }\n  }\n  if (!Number.isInteger(c.duracionHoras) || c.duracionHoras <= 0) {\n    throw new Error(`El curso id ${c.id} tiene una duracionHoras inválida`);\n  }\n  if (typeof c.activo !== 'boolean') {\n    throw new Error(`El curso id ${c.id} no indica si está activo`);\n  }\n}\nreturn [{ json: { cursos } }];"
        },
        "onError": "continueErrorOutput"
      },
      {
        "id": "a3c0e0b0-0000-4000-8000-000000000013",
        "name": "¿Existe la colección?",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.5,
        "position": [
          880,
          100
        ],
        "parameters": {
          "method": "GET",
          "url": "={{ $('Configuración').first().json.qdrantUrl }}/collections/{{ $('Configuración').first().json.coleccion }}/exists",
          "options": {
            "response": {
              "response": {
                "fullResponse": true,
