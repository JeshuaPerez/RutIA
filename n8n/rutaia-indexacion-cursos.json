      {
        "id": "a3c0e0b0-0000-4000-8000-000000000017",
        "name": "Leer configuración",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.5,
        "position": [
          1540,
          0
        ],
        "parameters": {
