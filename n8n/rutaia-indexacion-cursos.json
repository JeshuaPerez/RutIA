              }
            }
          }
        },
        "onError": "continueErrorOutput"
      },
      {
        "id": "a3c0e0b0-0000-4000-8000-000000000014",
        "name": "Decidir colección",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1100,
          100
        ],
        "parameters": {
          "jsCode": "// Lee result.exists de GET /collections/{coleccion}/exists.\nconst resp = $input.first().json;\nconst existe = resp.body?.result?.exists;\nif (resp.statusCode !== 200 || typeof existe !== 'boolean') {\n  throw new Error(`Qdrant respondió HTTP ${resp.statusCode} al comprobar si existe la colección`);\n}\nreturn [{ json: { existe } }];"
        },
        "onError": "continueErrorOutput"
      },
