# Copia este archivo como .env (en la misma carpeta raíz) y escribe tu propia contraseña.
# El .env no se versiona. Valores sin comillas, sin espacios y sin barras invertidas.
RUTAIA_DB_USER=rutaia_app
RUTAIA_DB_PASSWORD=
RUTAIA_DB_URL=jdbc:postgresql://127.0.0.1:5433/rutaia
RUTAIA_N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/rutaia-consulta-rag
RUTAIA_N8N_TIMEOUT_SEGUNDOS=90
RUTAIA_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
