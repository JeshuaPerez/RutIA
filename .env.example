# Copia este archivo como .env (en la misma carpeta raíz) y escribe tu propia contraseña.
# El .env no se versiona. Valores sin comillas, sin espacios y sin barras invertidas.
RUTAIA_DB_USER=rutaia_app
RUTAIA_DB_PASSWORD=
RUTAIA_N8N_TIMEOUT_SEGUNDOS=90
# Puerto de PostgreSQL en la máquina (docker compose y la URL JDBC de Spring).
RUTAIA_PUERTO_POSTGRES=5433
# Puerto de Qdrant en la máquina (docker compose); dentro de Docker los flujos usan qdrant:6333.
RUTAIA_PUERTO_QDRANT=6333
# Puerto de n8n en la máquina (docker compose y la URL del webhook en Spring).
RUTAIA_PUERTO_N8N=5678
# Puerto de la API Spring Boot (server.port y RUTAIA_API_URL del contenedor n8n).
RUTAIA_PUERTO_API=8080
# Puerto del frontend con jwebserver (orígenes CORS de Spring).
RUTAIA_PUERTO_FRONTEND=5500
